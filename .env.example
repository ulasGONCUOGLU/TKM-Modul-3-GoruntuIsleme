# Bu dosyayı ".env" olarak kopyalayıp doldurun. .env Git'e eklenmez.

# --- Sunucu ---
GORUNTU_HOST=127.0.0.1
GORUNTU_PORT=5001
# Nuxt arayüzünün adresi (tarayıcıdan API'ye erişime izin verilen adresler)
GORUNTU_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Sunucuya geçince "0" yapın (modelin disk yolunu elle yazarak kaydetmeyi kapatır)
GORUNTU_ALLOW_PATH_REGISTER=1

# --- Veritabanı: Supabase (ZORUNLU — ayarlar ve analiz kayıtları burada tutulur) ---
# Bu projenin KENDİ Supabase projesi (Yol Kapama'nınkinden ayrı).
# Dashboard → Project Settings → API
SUPABASE_URL=
# service_role anahtarı (GİZLİ — yalnızca bu sunucuda durur, tarayıcıya gitmez)
SUPABASE_SERVICE_ROLE_KEY=
